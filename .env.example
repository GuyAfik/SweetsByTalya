# ============================================================
# Sweets by Talya — Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is NEVER committed to git.
# ============================================================

# ---------------------------------------------------------------------------
# FRONTEND (VITE_* prefix — safe to embed in browser bundle)
# ---------------------------------------------------------------------------

# WhatsApp phone number shown in the UI (with country code, no + or spaces)
VITE_WHATSAPP_PHONE=972XXXXXXXXX

# Contact email shown in the UI
VITE_CONTACT_EMAIL=talya@sweetsbytalya.com

# Feature Flags (set to "false" to disable)
VITE_TELEMETRY_ENABLED=true
VITE_CHATBOT_ENABLED=true
VITE_PAYMENTS_ENABLED=false

# Default language if browser language cannot be detected (en | he | pt)
VITE_DEFAULT_LANGUAGE=en

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY (Vercel env vars — never exposed to the browser)
# ---------------------------------------------------------------------------

# --- Resend (https://resend.com — free: 3,000 emails/month) ---
# Sign up free → Dashboard → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address orders will be SENT TO (Talya's inbox)
CONTACT_EMAIL=talya@sweetsbytalya.com

# The "From" address shown in the email
# For testing: use onboarding@resend.dev (no domain verification needed)
# For production: use orders@sweetsbytalya.com (requires domain verification in Resend)
FROM_EMAIL=onboarding@resend.dev

# WhatsApp phone number for the "Reply via WhatsApp" button inside order emails
# Same number as VITE_WHATSAPP_PHONE but server-side (no VITE_ prefix)
WHATSAPP_PHONE=972XXXXXXXXX

# --- OpenAI ---
# Server-side only — stored in Vercel env vars, NEVER in the browser bundle
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
