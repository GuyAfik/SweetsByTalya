# ============================================================
# Sweets by Talya — Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is NEVER committed to git.
# ============================================================

# --- Contact ---
VITE_WHATSAPP_PHONE=972XXXXXXXXX
VITE_CONTACT_EMAIL=talya@sweetsbytalya.com

# --- Resend (https://resend.com — free: 3,000 emails/month) ---
# Used for: order confirmation emails + visit telemetry notifications
# Sign up free → Dashboard → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address orders will be SENT TO (Talya's inbox)
CONTACT_EMAIL=talya@sweetsbytalya.com

# The "From" address shown in the email (must be a verified domain in Resend)
# For testing you can use: onboarding@resend.dev (Resend's default sender)
FROM_EMAIL=orders@sweetsbytalya.com

# --- OpenAI (server-side only — stored in Vercel env vars for production) ---
# For LOCAL development only — this key is used by the local API proxy server
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Feature Flags ---
VITE_TELEMETRY_ENABLED=true
VITE_CHATBOT_ENABLED=true
VITE_PAYMENTS_ENABLED=false

# --- i18n ---
# Default language if browser language cannot be detected (en | he | pt)
VITE_DEFAULT_LANGUAGE=en
